{
  "rewrites": [
    {
      "source": "/",
      "destination": "/src/index.html"
    },
    {
      "source": "/style.css",
      "destination": "/src/style.css"
    },
    {
      "source": "/app.js",
      "destination": "/src/app.js"
    },
    {
      "source": "/storage.js",
      "destination": "/src/storage.js"
    },
    {
      "source": "/storage-supabase.js",
      "destination": "/src/storage-supabase.js"
    }
  ]
}
