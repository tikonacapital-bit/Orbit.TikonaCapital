{
  "manifest_version": 3,
  "name": "Tikona Tasklist",
  "version": "1.0.0",
  "description": "Multi-list task board with priorities, due dates, and cross-device sync — now with Supabase support.",
  "action": {
    "default_title": "Open Tasklist"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://*.supabase.co/*", "https://api.ipify.org/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
